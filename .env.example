# ── Frontend (Vite) — safe to expose client-side, prefix VITE_ ──────────────
VITE_AI_PROVIDER=vercel
VITE_PAYMENT_PROVIDER=vercel

VITE_VERCEL_API_BASE=https://exam-is-near-api.vercel.app
VITE_FIREBASE_FUNCTIONS_BASE=https://asia-south1-your-project.cloudfunctions.net

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# ── Vercel serverless functions (set in Vercel dashboard, NEVER commit) ────
# Firebase Console -> Project Settings -> Service Accounts -> Generate key
# Paste the full JSON (or base64 it) as one value.
# FIREBASE_SERVICE_ACCOUNT=

# Razorpay Dashboard -> Settings -> API Keys
# RZP_KEY_ID=
# RZP_KEY_SECRET=

# Razorpay Dashboard -> Settings -> Webhooks (payment.captured event)
# RAZORPAY_WEBHOOK_SECRET=

# console.groq.com/keys
# GROQ_API_KEY=

# aistudio.google.com/apikey — Gemini fallback for groq-proxy
# GEMINI_API_KEY=

# Vercel Project Settings -> Environment Variables (auto-sent as
# Authorization: Bearer <this> on cron invocations)
# CRON_SECRET=

# ayushmantripathi17@gmail.com by default if unset
# ADMIN_EMAIL=

# CORS allowlist, comma-separated
# ALLOWED_ORIGINS=https://exam-is-near.web.app,https://exam-is-near.firebaseapp.com,http://localhost:5000,http://localhost:3000
